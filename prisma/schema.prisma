// =========================================================
// EDGEFINDER REFERENCE + COMPASS TABLES
// =========================================================

model CurrencyCycleStance {
  id            String    @id @default(uuid())
  currencyCode  String    @map("currency_code") @db.VarChar(3)
  stance        String    @db.VarChar(10)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  // Phase 6 (Addendum 8B): Fed constraint for the gold override gate. A single
  // global, effective-dated judgment value about the Fed — stored ADDITIVELY
  // on this table's USD rows (Fed ↔ USD), resolved with the same
  // greatest-effective_date-<=t convention as `stance`. Nullable; a null/absent
  // value reads as 'FREE' (the fail-safe default, so Override 2 behaves
  // classically). Values: 'FREE' | 'CONSTRAINED'. Non-USD rows leave it null.
  fedConstraint String?   @map("fed_constraint") @db.VarChar(12)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")

  @@unique([currencyCode, effectiveFrom])
  @@index([currencyCode, effectiveFrom(sort: Desc)])
  @@map("currency_cycle_stance")
}

model PairTemplateRow {
  id               String  @id @default(uuid())
  rowCode          String  @unique @map("row_code") @db.VarChar(30)
  displayName      String  @map("display_name") @db.VarChar(50)
  uiGroup          String  @map("ui_group") @db.VarChar(20)
  treatment        String  @db.VarChar(30)
  usIndicatorCode  String? @map("us_indicator_code") @db.VarChar(50)
  eurIndicatorCode String? @map("eur_indicator_code") @db.VarChar(50)
  gbpIndicatorCode String? @map("gbp_indicator_code") @db.VarChar(50)
  jpyIndicatorCode String? @map("jpy_indicator_code") @db.VarChar(50)
  rowOrder         Int     @map("row_order")
  isActive         Boolean @default(true) @map("is_active")

  currencies PairTemplateRowCurrency[]

  @@index([rowOrder])
  @@map("pair_template_rows")
}

// Phase 1 (AUD expansion): normalised replacement for PairTemplateRow's four
// hardcoded currency columns (us/eur/gbp/jpy_indicator_code). Currency becomes a
// ROW, not a column, so a 5th+ economy is a data insert instead of an ALTER TABLE.
//
// indicatorCode is nullable on purpose: a currency can legitimately have no
// equivalent for a given template row (e.g. AUD has no PCE counterpart), and the
// pair-row calculator needs to distinguish "mapped to nothing" from "not mapped".
//
// The four legacy columns on PairTemplateRow remain in place and authoritative
// until a later phase switches loadPairTemplateFromDb() over to this table.
model PairTemplateRowCurrency {
  id            String   @id @default(uuid())
  templateRowId String   @map("template_row_id")
  currencyCode  String   @map("currency_code") @db.VarChar(3)
  indicatorCode String?  @map("indicator_code") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  templateRow PairTemplateRow @relation(fields: [templateRowId], references: [id], onDelete: Cascade)

  @@unique([templateRowId, currencyCode])
  @@index([currencyCode])
  @@index([indicatorCode])
  @@map("pair_template_row_currencies")
}

// Phase 1 (AUD expansion): data-driven replacement for the two hardcoded
// structures in asset-indicator-resolver.ts — COUNTRY_BY_ASSET (membership by
// country string) and flipScoreForGold (a single boolean negating every
// indicator for Gold).
//
// polarity replaces the boolean because indices need MIXED signs: a growth beat
// is bullish for both USD and equities (+1), while an inflation beat is bullish
// USD but bearish equities (-1). One global flip cannot express that.
//
// Composition is: final = ruleLayerScore * polarity. The rule layer already
// encodes indicator-level direction (e.g. `inverted` for unemployment), so
// polarity is strictly the asset-level view on top of it.
//
// COUNTRY_BY_ASSET and flipScoreForGold remain authoritative until a later
// phase switches resolveAssetIndicators() over to this table.
model AssetIndicatorMap {
  id          String   @id @default(uuid())
  assetId     String   @map("asset_id")
  indicatorId String   @map("indicator_id")
  polarity    Int      @default(1) @db.SmallInt
  isCot       Boolean  @default(false) @map("is_cot")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([assetId, indicatorId])
  @@index([assetId])
  @@index([indicatorId])
  @@map("asset_indicator_map")
}

model CompassInput {
  id              String     @id @default(uuid())
  observationDate DateTime   @map("observation_date") @db.Date
  inputCode       String     @map("input_code") @db.VarChar(30)
  rawValue        Decimal?   @map("raw_value") @db.Decimal(20, 6)
  derivedValue    Decimal?   @map("derived_value") @db.Decimal(20, 6)
  colorBand       String     @map("color_band") @db.VarChar(10)
  subChecks       Json?      @map("sub_checks")
  source          DataSource
  isValidation    Boolean    @default(false) @map("is_validation")
  computedAt      DateTime   @default(now()) @map("computed_at")

  @@unique([observationDate, inputCode, isValidation])
  @@index([observationDate(sort: Desc)])
  @@index([inputCode, observationDate(sort: Desc)])
  @@index([observationDate, isValidation])
  @@map("compass_inputs")
}

model CompassClassification {
  id                 String   @id @default(uuid())
  classificationDate DateTime @map("classification_date") @db.Date
  vintageDate        DateTime @default(now()) @map("vintage_date")
  isCurrent          Boolean  @default(true) @map("is_current")

  candidateRegime      String  @map("candidate_regime") @db.VarChar(15)
  activeRegime         String  @map("active_regime") @db.VarChar(15)
  persistenceDaysCount Int     @default(0) @map("persistence_days_count")
  // crisisOverrideFired: retired by Phase 4's Shock Layer (Trigger A now
  // serves the same same-day Risk-Off bypass). Column KEPT as historical
  // record — always false going forward, never dropped.
  crisisOverrideFired  Boolean @default(false) @map("crisis_override_fired")

  // Phase 4 Shock Layer: finalRegime = Risk-Off when shockAActive, else
  // activeRegime unchanged. shockBActive is exposed but does not yet affect
  // finalRegime or overrides (Phase 6 wires its override effect).
  finalRegime  String  @default("") @map("final_regime") @db.VarChar(15)
  shockAActive Boolean @default(false) @map("shock_a_active")
  shockBActive Boolean @default(false) @map("shock_b_active")

  // Phase 6 audit columns — the daily record of what the two override gates
  // (Addenda 8A rate gate / 8B fed constraint) decided.
  //   us02yClose / us02ySma21 = the rate-gate inputs (raw DGS2 close and its
  //     21-obs SMA) as of the date. Null on pre-Phase-6 rows / when the gate
  //     couldn't compute (failed open).
  //   rateGateHawkish = us02yClose > us02ySma21 (strict, 6-dp rounded).
  //   override3/5SuppressedByGate = the JPY safe-haven/carry overrides were
  //     suppressed because the rate gate was hawkish and no Trigger B bypass.
  //   fedConstraint = the resolved Fed constraint ('FREE'|'CONSTRAINED') as of
  //     the date, from currency_cycle_stance (Addendum 8B). '' on pre-Phase-6.
  //   override2SuppressedByConstraint = the gold override was suppressed
  //     because fedConstraint was FREE under a Risk-Off regime path.
  //   overridesActive = the POST-gate final override set that actually fired
  //     (JSON array of override codes) — self-explaining daily log.
  us02yClose                     Decimal? @map("us02y_close") @db.Decimal(20, 6)
  us02ySma21                     Decimal? @map("us02y_sma21") @db.Decimal(20, 6)
  rateGateHawkish                Boolean  @default(false) @map("rate_gate_hawkish")
  override3SuppressedByGate      Boolean  @default(false) @map("override_3_suppressed_by_gate")
  override5SuppressedByGate      Boolean  @default(false) @map("override_5_suppressed_by_gate")
  fedConstraint                  String   @default("") @map("fed_constraint") @db.VarChar(12)
  override2SuppressedByConstraint Boolean @default(false) @map("override_2_suppressed_by_constraint")
  overridesActive                Json?    @map("overrides_active")

  totalGreenWeight  Decimal @map("total_green_weight") @db.Decimal(5, 2)
  totalYellowWeight Decimal @map("total_yellow_weight") @db.Decimal(5, 2)
  totalRedWeight    Decimal @map("total_red_weight") @db.Decimal(5, 2)

  voteBreakdown Json     @map("vote_breakdown")
  isValidation  Boolean  @default(false) @map("is_validation")
  computedAt    DateTime @default(now()) @map("computed_at")

  @@unique([classificationDate, vintageDate])
  @@index([classificationDate(sort: Desc)])
  @@index([classificationDate, isCurrent], map: "compass_classifications_date_current_idx")
  @@index([classificationDate, isValidation])
  @@map("compass_classifications")
}

model CompassValidationReport {
  id            String   @id @default(uuid())
  generatedAt   DateTime @default(now()) @map("generated_at")
  overallPassed Boolean  @map("overall_passed")
  windowResults Json     @map("window_results")
  summary       String

  @@index([generatedAt(sort: Desc)])
  @@map("compass_validation_reports")
}

model CompassConfig {
  id             String    @id @default(uuid())
  versionLabel   String    @map("version_label") @db.VarChar(20)
  configDefinition Json    @map("config_definition")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  createdBy      String?   @map("created_by")

  @@unique([versionLabel])
  @@index([effectiveFrom])
  @@map("compass_config")
}

/**
 * Cache of the most-recently-scanned T10Y2Y inversion episode, keyed by
 * isValidation so live and backfill/validation runs don't collide (mirrors
 * compass_inputs / compass_classifications). This table is NOT the source of
 * truth — it can be wiped and fully recomputed by re-scanning T10Y2Y history
 * (see compass-curve-state-machine.ts + compass-curve-state.repository.ts).
 * One current row per isValidation space; `computedForDate` records which
 * observation date the cached scan was last refreshed for.
 */
model CompassCurveState {
  id                String   @id @default(uuid())
  isValidation      Boolean  @default(false) @map("is_validation")
  computedForDate   DateTime @map("computed_for_date") @db.Date
  inversionStart    DateTime? @map("inversion_start") @db.Date
  unInversionDate   DateTime? @map("un_inversion_date") @db.Date
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([isValidation])
  @@map("compass_curve_state")
}

/**
 * Cache of the Shock Layer's two trigger states (Phase 4), keyed by
 * isValidation, mirroring compass_curve_state's pattern exactly. This table
 * is NOT the source of truth — it can be wiped and fully recomputed by
 * re-scanning VIX/OAS/USDJPY history (see compass-shock-layer.ts +
 * compass-shock-state.repository.ts). One current row per isValidation
 * space. Each trigger's `*Expiry` is the trading-day it stops being active
 * (inclusive); a fresh same-trigger firing RESETS (not stacks) the expiry.
 */
model CompassShockState {
  id              String    @id @default(uuid())
  isValidation    Boolean   @default(false) @map("is_validation")
  computedForDate DateTime  @map("computed_for_date") @db.Date
  shockAActive    Boolean   @default(false) @map("shock_a_active")
  shockAExpiry    DateTime? @map("shock_a_expiry") @db.Date
  shockBActive    Boolean   @default(false) @map("shock_b_active")
  shockBExpiry    DateTime? @map("shock_b_expiry") @db.Date
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([isValidation])
  @@map("compass_shock_state")
}

// =========================================================
// TRADING HUB (Dashboard + Trading Hub frontend sections)
//
// Per-user trading journal. Ownership is enforced at the
// application layer via `userId` (the Supabase user UUID),
// matching the codebase's existing app-layer multi-tenancy.
// No FK to `users` is declared so the User model is left
// untouched. Constrained string fields (direction, status,
// conviction, etc.) carry the exact frontend literal values
// and are validated by Zod at the API boundary.
// =========================================================

model TradingAccount {
  id              String   @id @default(uuid())
  userId          String   @map("user_id") @db.Uuid
  accountType     String   @map("account_type") @db.VarChar(20) // personal | demo | prop_firm
  accountName     String   @map("account_name") @db.VarChar(120)
  accountSize     Decimal  @map("account_size") @db.Decimal(20, 2) // starting balance
  currentBalance  Decimal  @map("current_balance") @db.Decimal(20, 2)
  currency        String   @default("USD") @db.VarChar(8)
  status          String   @default("Active") @db.VarChar(20) // Active | Passed | Blown | Closed
  startingDate    DateTime @map("starting_date") @db.Date
  broker          String?  @db.VarChar(120)
  profitGoalPct   Decimal? @map("profit_goal_pct") @db.Decimal(8, 2)
  propFirm        String?  @map("prop_firm") @db.VarChar(120)
  stage           String?  @db.VarChar(20) // Stage 1 | Stage 2 | Funded | Blown
  maxDrawdownPct  Decimal? @map("max_drawdown_pct") @db.Decimal(8, 2)
  profitTargetPct Decimal? @map("profit_target_pct") @db.Decimal(8, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  executions Execution[]
  cashFlows  CashFlow[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("trading_accounts")
}

// Trade = the idea: one setup, one pair, one direction, one entry rationale.
// This is the unit every edge statistic counts. The actual fills — account,
// risk %, lot size, actual prices, exit, P&L, R — live on Execution, one per
// account the idea was taken in. Edge is a property of the setup; P&L is a
// property of the account.
model Trade {
  id               String   @id @default(uuid())
  userId           String   @map("user_id") @db.Uuid
  model            String   @db.VarChar(60)
  pair             String   @db.VarChar(20)
  direction        String   @db.VarChar(8) // Buy | Sell
  plannedEntry     Decimal  @map("planned_entry") @db.Decimal(20, 6)
  plannedSl        Decimal  @map("planned_sl") @db.Decimal(20, 6)
  plannedFirstTp   Decimal? @map("planned_first_tp") @db.Decimal(20, 6)
  plannedMainTp    Decimal  @map("planned_main_tp") @db.Decimal(20, 6)
  conviction       String   @db.VarChar(10) // Low | Medium | High
  dateOpened       DateTime @map("date_opened")
  session          String   @db.VarChar(24)
  screenshots      String[]
  psychology       String?  @db.VarChar(120)
  notes            String?

  // The Oracle score for this pair AS OF the entry date, captured once at
  // write time and never recomputed. Replaces the old `fundamental_score`,
  // which was a live, undated read taken at whatever moment the form
  // happened to be open — the same fact, captured badly.
  //
  //   oracleScoreAtEntry         the score itself; null when none exists for
  //                              that date (before scoring began, a gap, a
  //                              non-trading day). Never carried forward from
  //                              a nearby date, never fabricated.
  //   oracleScoreEntryDate       the calendar date (UTC) the score is
  //                              addressed to. Null for legacy values, which
  //                              are addressed to no date.
  //   oracleScoreEntryCapturedAt when the snapshot was taken.
  //   oracleScoreEntrySource     'snapshot' — read from a real score row for
  //                              oracleScoreEntryDate.
  //                              'legacy'   — carried across from the old
  //                                           fundamental_score at migration.
  //                              'manual'   — the user typed it.
  oracleScoreAtEntry         Int?      @map("oracle_score_at_entry") @db.SmallInt
  oracleScoreEntryDate       DateTime? @map("oracle_score_entry_date") @db.Date
  oracleScoreEntryCapturedAt DateTime? @map("oracle_score_entry_captured_at")
  oracleScoreEntrySource     String?   @map("oracle_score_entry_source") @db.VarChar(10)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  executions Execution[]

  // Hot path: list a user's ideas newest-first.
  @@index([userId, dateOpened(sort: Desc)])
  @@map("trades")
}

// Execution = the fill, per account. Its own account, risk %, lot size, actual
// entry, exit, P&L and R. Exactly one execution per trade is flagged primary —
// the idea's outcome, for edge statistics, is the primary execution's outcome.
// The at-most-one-primary-per-trade invariant is enforced by a partial unique
// index (see migration SQL, Prisma cannot express a WHERE-qualified unique
// index in schema.prisma directly).
model Execution {
  id                String    @id @default(uuid())
  tradeId           String    @map("trade_id")
  accountId         String    @map("account_id")
  isPrimary         Boolean   @default(false) @map("is_primary")
  riskPct           Decimal   @map("risk_pct") @db.Decimal(8, 2)
  lotSize           Decimal   @map("lot_size") @db.Decimal(12, 4)
  entryPrice        Decimal   @map("entry_price") @db.Decimal(20, 6)
  partialExitPrice  Decimal?  @map("partial_exit_price") @db.Decimal(20, 6)
  partialExitLotPct Decimal?  @map("partial_exit_lot_pct") @db.Decimal(8, 2)
  mainExitPrice     Decimal?  @map("main_exit_price") @db.Decimal(20, 6)
  exitType          String    @default("TP") @map("exit_type") @db.VarChar(16) // TP | SL | Manual | Partial+TP | Partial+SL | BE
  dateClosed        DateTime? @map("date_closed")
  totalPips         Decimal   @default(0) @map("total_pips") @db.Decimal(12, 2)
  blendedPnl        Decimal   @default(0) @map("blended_pnl") @db.Decimal(20, 2)
  blendedRr         Decimal   @default(0) @map("blended_rr") @db.Decimal(12, 2)

  // The Oracle score for the trade's pair AS OF this execution's exit date.
  // Exit lives here, not on Trade, because dateClosed is per-account: two
  // accounts can close the same idea on different days and therefore against
  // different scores. Same snapshot rules as the entry side — captured once,
  // keyed to the date, null when no score row exists, never recomputed.
  oracleScoreAtExit         Int?      @map("oracle_score_at_exit") @db.SmallInt
  oracleScoreExitDate       DateTime? @map("oracle_score_exit_date") @db.Date
  oracleScoreExitCapturedAt DateTime? @map("oracle_score_exit_captured_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  trade   Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([accountId])
  @@index([accountId, dateClosed])
  @@map("executions")
}

model PlannedTrade {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id") @db.Uuid
  pair               String   @db.VarChar(20)
  model              String   @db.VarChar(60)
  direction          String   @db.VarChar(8) // Buy | Sell
  plannedEntry       Decimal  @map("planned_entry") @db.Decimal(20, 6)
  plannedSl          Decimal  @map("planned_sl") @db.Decimal(20, 6)
  plannedFirstTp     Decimal? @map("planned_first_tp") @db.Decimal(20, 6)
  plannedMainTp      Decimal  @map("planned_main_tp") @db.Decimal(20, 6)
  plannedRiskPct     Decimal  @map("planned_risk_pct") @db.Decimal(8, 2)
  conviction         String   @db.VarChar(10) // Low | Medium | High
  status             String   @default("Watching") @db.VarChar(16) // Watching | Ready | Invalidated | Cancelled
  dateAdded          DateTime @default(now()) @map("date_added")
  notes              String?
  screenshots        String[]
  currentMarketPrice Decimal  @map("current_market_price") @db.Decimal(20, 6)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, dateAdded(sort: Desc)])
  @@map("planned_trades")
}

model CashFlow {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @db.Uuid
  accountId String   @map("account_id")
  type      String   @db.VarChar(16) // deposit | withdrawal | payout
  amount    Decimal  @db.Decimal(20, 2) // positive magnitude; `type` carries direction
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, date])
  @@index([userId])
  @@map("cash_flows")
}

model TradingModel {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(60)
  description String   @default("") @db.VarChar(200)
  rules       String   @default("")
  status      String   @default("Active") @db.VarChar(12) // Active | Inactive
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("trading_models")
}

model TradingPair {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") @db.Uuid
  symbol      String   @db.VarChar(20)
  displayName String   @map("display_name") @db.VarChar(40)
  flagA       String   @map("flag_a") @db.VarChar(16)
  flagB       String   @map("flag_b") @db.VarChar(16)
  pipValue    Decimal  @map("pip_value") @db.Decimal(12, 4)
  status      String   @default("Active") @db.VarChar(12) // Active | Inactive
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, symbol])
  @@index([userId])
  @@map("trading_pairs")
}
