// Lucid Backend - Prisma Schema
// Phase 1: Foundation schema for NIFTY tool and EdgeFinder tool.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// ENUMS
// =========================================================

enum AssetClass {
  index
  forex_pair
  commodity
  equity
  currency
}

enum IndicatorCategory {
  domestic
  flow
  sentiment
  global
  india_specific
}

enum IndicatorTool {
  nifty
  edgefinder
  shared
}

enum IndicatorFrequency {
  daily
  weekly
  monthly
  quarterly
  event_driven
}

enum DataSource {
  fred
  nse_scrape
  cftc
  manual
  derived
  yahoo
  jblanked // dead value, no rows use it, kept for enum stability
  forex_factory
  eodhd
  crude_price_api
}

enum ScoringRuleType {
  threshold
  direction
  band
  custom
  normal
  inverted
  cpi_rate_cycle
  us02y_sma
  rate_decision
  cot_two_component
}

enum DataQualityFlag {
  estimated
  revised
  carry_forward
  suspect
}

enum FetchTriggerType {
  cron
  manual
  backfill
}

enum FetchStatus {
  running
  success
  partial
  failed
}

enum UserRole {
  user
  admin
}

enum CompositeGroup {
  domestic
  external
}

enum ToolName {
  nifty
  edgefinder
}

// =========================================================
// REFERENCE TABLES
// =========================================================

model Asset {
  id         String     @id @default(uuid())
  code       String     @unique @db.VarChar(20)
  name       String     @db.VarChar(100)
  assetClass AssetClass @map("asset_class")
  toolScope  String[]   @map("tool_scope")
  metadata   Json?
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  edgefinderScorecards EdgefinderScorecard[]
  edgefinderPairScores EdgefinderPairScore[]
  cotData              CotData[]
  indicatorMaps        AssetIndicatorMap[]

  @@index([assetClass])
  @@index([toolScope], type: Gin)
  @@map("assets")
}

model Indicator {
  id             String             @id @default(uuid())
  code           String             @unique @db.VarChar(50)
  name           String             @db.VarChar(200)
  category       IndicatorCategory
  tool           IndicatorTool
  frequency      IndicatorFrequency
  unit           String?            @db.VarChar(20)
  dataSource     DataSource         @map("data_source")
  sourceSeriesId String?            @map("source_series_id") @db.VarChar(50)
  description    String?
  displayOrder   Int?               @map("display_order")
  compositeGroup CompositeGroup?    @map("composite_group")
  country        String?            @db.VarChar(3)
  uiGroup        String?            @map("ui_group") @db.VarChar(20)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  scoringRules   ScoringRule[]
  dataPoints     DataPoint[]
  scores         Score[]
  assetMaps      AssetIndicatorMap[]
  variants       IndicatorVariant[]
  calendarEvents CalendarEvent[]
  deferrals      CalendarEventDeferral[]

  @@index([tool, isActive])
  @@index([dataSource, frequency])
  @@map("indicators")
}

model ScoringRule {
  id             String          @id @default(uuid())
  indicatorId    String          @map("indicator_id")
  version        Int
  ruleType       ScoringRuleType @map("rule_type")
  ruleDefinition Json            @map("rule_definition")
  effectiveFrom  DateTime        @map("effective_from") @db.Date
  effectiveTo    DateTime?       @map("effective_to") @db.Date
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  createdBy      String?         @map("created_by")

  indicator Indicator @relation(fields: [indicatorId], references: [id])
  scores    Score[]

  @@unique([indicatorId, version])
  @@index([indicatorId, effectiveFrom])
  @@map("scoring_rules")
}

model ScorecardRatingRule {
  id            String    @id @default(uuid())
  tool          ToolName
  version       Int
  rules         Json
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")

  niftyScorecards NiftyScorecard[]

  @@unique([tool, version])
  @@map("scorecard_rating_rules")
}

// =========================================================
// DATA TABLES
// =========================================================

model DataPoint {
  id              String           @id @default(uuid())
  indicatorId     String           @map("indicator_id")
  observationDate DateTime         @map("observation_date") @db.Date
  // Release variant (Flash/Final, Advance/Second/Third, Prelim/Final, ...).
  // Null = single-release indicator, the common case. Allowed values per
  // indicator are data (see IndicatorVariant), never a hardcoded enum here —
  // a new release type must never require a code change.
  variant         String?          @db.VarChar(20)
  // True only for rows that existed on a multi-variant indicator before
  // variants existed. Set once, at migration time, never inferred which
  // variant they actually were (precedent: deprecated IND_NIFTY_03_CPI rows,
  // 2025 AUD discontinuity flags — flag and leave alone). Never set on rows
  // written after variants exist; those always carry a real variant or null.
  isLegacyVariant Boolean          @default(false) @map("is_legacy_variant")
  value           Decimal          @db.Decimal(20, 6)
  forecastValue   Decimal?         @map("forecast_value") @db.Decimal(20, 6)
  previousValue   Decimal?         @map("previous_value") @db.Decimal(20, 6)
  vintageDate     DateTime         @default(now()) @map("vintage_date")
  isCurrent       Boolean          @default(true) @map("is_current")
  dataQualityFlag DataQualityFlag? @map("data_quality_flag")
  source          DataSource
  sourceMetadata  Json?            @map("source_metadata")
  notes           String?
  fetchedVia      String?          @map("fetched_via")
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       String?          @map("created_by")

  indicator Indicator     @relation(fields: [indicatorId], references: [id])
  fetchLog  DataFetchLog? @relation(fields: [fetchedVia], references: [id])
  scores    Score[]

  // variant participates so Flash and Final can coexist on the same
  // observationDate. Prisma treats NULL as distinct per-row in a unique
  // index (Postgres semantics), so single-release indicators (variant always
  // null) keep exactly the same collision behaviour as before this migration.
  @@unique([indicatorId, observationDate, variant, vintageDate])
  @@index([indicatorId, observationDate(sort: Desc)])
  @@index([vintageDate(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  // Hot path for B3's scoring resolution: latest release regardless of
  // variant. isCurrent narrows to one row per (indicator, observationDate,
  // variant); ordering the remainder by observationDate then variant is done
  // in application code since variant ordinal (the real tiebreaker) lives in
  // IndicatorVariant, not as a sortable column on this row.
  @@index([indicatorId, isCurrent, observationDate(sort: Desc)], map: "data_points_indicator_current_date_idx")
  @@map("data_points")
}

// Registry of allowed release variants per indicator, and each variant's
// ordinal (Flash 1 / Final 2, Advance 1 / Second 2 / Third 3, ...). Data, not
// an application-code enum: adding a new release type for an indicator is a
// row insert here, never a code change. Absence of any row for an indicator
// means that indicator is single-release (DataPoint.variant stays null).
model IndicatorVariant {
  id          String   @id @default(uuid())
  indicatorId String   @map("indicator_id")
  variant     String   @db.VarChar(20)
  // Release order within the indicator's ladder. Primary tiebreaker for B3's
  // scoring resolution — a property of the release itself, independent of
  // when it happened to be entered (vintageDate, entry order).
  ordinal     Int      @db.SmallInt
  // Finals-only is the sane default history view for a Flash/Final pair (see
  // B5); GDP-style ladders (Advance/Second/Third, Prelim/Final) default to
  // showing every rung since each one moves meaningfully. Derived from this
  // column, never a hardcoded indicator list in frontend/backend code.
  isFinal     Boolean  @default(false) @map("is_final")
  createdAt   DateTime @default(now()) @map("created_at")

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([indicatorId, variant])
  @@unique([indicatorId, ordinal])
  @@index([indicatorId])
  @@map("indicator_variants")
}

// One row per SCHEDULED EVENT OCCURRENCE from the Forex Factory calendar.
//
// Distinct from DataPoint on purpose. DataPoint models an OBSERVATION that
// feeds scoring — it requires a value and is keyed by observationDate.
// CalendarEvent models the RELEASE SCHEDULE: when a print is due, what it
// will be, and whether an actual has landed yet. An event exists here from
// the moment it is announced, long before any number is published.
//
// Retention is permanent. The feed is current-week-only (ff_calendar_
// nextweek.json and _lastweek.json both 404), so a week that is not stored
// while it is "this week" is lost with no way to re-fetch it. Nothing in
// this table is ever pruned.
model CalendarEvent {
  id String @id @default(uuid())

  // ---- Identity (the natural key) ------------------------------------
  // Sourced verbatim from the feed. `country` is FF's value, which is a
  // CURRENCY code (CNY, AUD), not the ISO country code Indicator.country
  // stores (CN, AU) — they are deliberately not reconciled here so the key
  // stays a faithful record of what upstream sent.
  source    String   @default("forex_factory") @db.VarChar(30)
  country   String   @db.VarChar(8)
  title     String   @db.VarChar(200)
  // The UTC INSTANT of the release. The feed sends ISO-8601 with a -04:00
  // offset; ingest converts to UTC and stores that. Never a local-time
  // string, and never a bare date — every observed event carries a real
  // time component (verified: 0 of 99 events at T00:00:00, 46 distinct
  // clock times). Rendering converts back to the viewer's timezone.
  scheduledAt DateTime @map("scheduled_at")

  // ---- Payload -------------------------------------------------------
  impact String @db.VarChar(16)
  // Stored UNCONDITIONALLY, including when `actual` is absent — an event
  // with no actual yet is a scheduled release, not a discardable row.
  //
  // REFERENCE ONLY. `forecast` is Forex Factory's own consensus, which is
  // considered unreliable; the user enters forecasts manually from Trading
  // Economics. NO SCORING PATH MAY EVER READ THIS COLUMN. It exists so a
  // future cross-check can compare the two sources — reading it into the
  // surprise calculation would corrupt every score derived from it.
  forecastRaw String? @map("forecast_raw") @db.VarChar(40)
  previousRaw String? @map("previous_raw") @db.VarChar(40)
  // Null until the release publishes. Populated on a later same-week run.
  actualRaw   String? @map("actual_raw") @db.VarChar(40)

  // ---- Resolution ----------------------------------------------------
  // Null indicatorId = unmapped: the (country, title) pair matched no entry
  // in FF_EVENT_TO_INDICATOR. These rows ARE the admin unmapped queue — an
  // upstream rename surfaces as a queue entry, never as a silent gap.
  indicatorId   String? @map("indicator_id")
  // Denormalised so the unmapped queue and the calendar list render without
  // a join, and so a resolution that later changes is visibly historical.
  indicatorCode String? @map("indicator_code") @db.VarChar(50)
  // The registered release variant (flash/final/prelim/...) this occurrence
  // denotes, or null for a single-release indicator. Mirrors DataPoint.variant.
  variant       String? @map("variant") @db.VarChar(20)
  // Companion-event designation (see the COMPANION EVENTS doc in
  // forex-factory-event-mapping.ts). true for every mapped row except the
  // small set of companion titles (e.g. AU_RBA_RATE's "RBA Rate Statement"),
  // where one real-world release sends two calendar rows at the same
  // instant. Denormalised from the mapping table at ingest time — same
  // reasoning as indicatorCode above, so the overdue resolver and calendar
  // render can read it without a join back to the mapping table.
  //
  // Defaults true so every unmapped row (indicatorId IS NULL) and every
  // pre-migration row is primary by default — companion is an opt-IN
  // designation on a handful of known titles, never the default state.
  isPrimary     Boolean @default(true) @map("is_primary")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt @map("last_seen_at")
  fetchedVia  String?  @map("fetched_via")

  // indicatorId is nullable BY DESIGN — null IS the unmapped queue. The FK is
  // still declared so a non-null value can never point at a deleted indicator.
  indicator Indicator?    @relation(fields: [indicatorId], references: [id], onDelete: SetNull)
  fetchLog  DataFetchLog? @relation(fields: [fetchedVia], references: [id], onDelete: SetNull)

  // Re-fetching the same event UPDATES rather than duplicates. The feed is
  // pulled twice daily and every run re-sends the whole week, so this key is
  // load-bearing: without it each event would be inserted ~14 times.
  //
  // scheduledAt participates because Forex Factory reschedules events — a
  // moved release is genuinely a different occurrence, and collapsing the two
  // would lose the original slot. A rescheduled event therefore appears as a
  // new row; that is intended.
  @@unique([source, country, title, scheduledAt], name: "calendar_event_natural_key")
  // Hot path: the calendar page's "today + rest of this week" window.
  @@index([scheduledAt])
  // Serves both the per-indicator lookup and the admin unmapped queue: the
  // queue is indicatorId IS NULL ordered by scheduledAt, which this same
  // index satisfies (Postgres indexes NULLs in a btree).
  @@index([indicatorId, scheduledAt(sort: Desc)])
  deferrals CalendarEventDeferral[]
  @@map("calendar_events")
}

// B2 — deferral (snooze) state for an OVERDUE calendar event. Never a
// suppression: entering data for the indicator+variant+date the event
// resolves to clears the row regardless of deferral state (see
// clearDeferralsForEntry in overdue-resolver.ts). This table only ever
// silences the badge/list surfacing of an overdue event; it never changes
// whether the event IS overdue (that remains purely a function of
// scheduledAt + DataPoint presence).
//
// Two shapes, distinguished by calendarEventId:
//   - NOT NULL: a one-off deferral of exactly that occurrence.
//   - NULL: a STANDING deferral of (indicatorId, variant) — "also apply to
//     future releases of the same indicator" from B2. Matches any future
//     overdue event for that indicator+variant until revoked, not just the
//     one being deferred when it was created. indicatorId is therefore
//     required in this shape; variant may be null (single-release indicator).
model CalendarEventDeferral {
  id String @id @default(uuid())

  // Null = standing deferral (see model doc above). The FK is intentionally
  // NOT onDelete:Cascade — a deferred event is exactly the kind of row an
  // admin might want history on even if the calendar_events row it pointed
  // at were ever purged, so a cascade-delete would silently erase deferral
  // history it shouldn't. In practice calendar_events rows are never deleted
  // (see that model's retention note), so this is a belt-and-braces choice
  // rather than one this schema expects to be exercised.
  calendarEventId String?        @map("calendar_event_id")
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id])

  // Required on EVERY row (both shapes) — a standing deferral has no
  // calendarEventId to derive it from, so it must be stored directly.
  indicatorId String     @map("indicator_id")
  indicator   Indicator  @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  // Denormalised alongside indicatorId for the same reason CalendarEvent
  // denormalises indicatorCode: list/badge queries read it without a join.
  indicatorCode String   @map("indicator_code") @db.VarChar(50)
  variant       String?  @db.VarChar(20)

  // Null = deferred indefinitely (B2). Non-null = deferred to a date; the
  // deferral itself expires and the event returns to overdue once
  // deferUntil passes — enforced by the resolver reading this column at
  // query time, not by a background job (this repo runs no deferral-expiry
  // cron; "derived on read" per this prompt's own constraint).
  deferUntil DateTime? @map("defer_until") @db.Date

  // Prompted but optional at entry; never required to defer.
  reason String? @db.VarChar(280)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  // A standing deferral only makes sense once per (indicator, variant) — a
  // second standing deferral for the same pair would just be an update, not
  // a new row, and the resolver only needs to find the newest anyway.
  //
  // Enforced with a PARTIAL unique index in raw SQL
  // (calendar_event_deferrals_standing_unique, WHERE calendar_event_id IS
  // NULL) rather than a Prisma @@unique, because Prisma's schema DSL has no
  // partial-unique syntax and the constraint must NOT apply to one-off
  // deferrals — two one-off deferrals of two different events must both be
  // allowed to exist. This is expected, permanent drift between this file
  // and the live schema: `prisma migrate dev`/`db pull` will not see the
  // partial index reflected here. Do not attempt to "fix" it by adding a
  // non-partial @@unique — that would incorrectly block a second concurrent
  // one-off deferral.
  @@index([calendarEventId])
  @@index([indicatorId, variant])
  @@map("calendar_event_deferrals")
}

model DataFetchLog {
  id             String           @id @default(uuid())
  jobName        String           @map("job_name") @db.VarChar(100)
  triggerType    FetchTriggerType @map("trigger_type")
  triggeredBy    String?          @map("triggered_by")
  targetDateFrom DateTime?        @map("target_date_from") @db.Date
  targetDateTo   DateTime?        @map("target_date_to") @db.Date
  status         FetchStatus
  startedAt      DateTime         @default(now()) @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  durationMs     Int?             @map("duration_ms")
  rowsInserted   Int              @default(0) @map("rows_inserted")
  rowsUpdated    Int              @default(0) @map("rows_updated")
  rowsSkipped    Int              @default(0) @map("rows_skipped")
  errors         Json?
  metadata       Json?

  dataPoints     DataPoint[]
  calendarEvents CalendarEvent[]

  @@index([jobName, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([triggeredBy])
  @@map("data_fetch_log")
}

// =========================================================
// SCORING TABLES
// =========================================================

model Score {
  id                  String   @id @default(uuid())
  indicatorId         String   @map("indicator_id")
  observationDate     DateTime @map("observation_date") @db.Date
  score               Int      @db.SmallInt
  flag                String?  @db.VarChar(50)
  ruleVersionId       String   @map("rule_version_id")
  dataPointId         String   @map("data_point_id")
  computedAt          DateTime @default(now()) @map("computed_at")
  computationMetadata Json?    @map("computation_metadata")

  indicator   Indicator   @relation(fields: [indicatorId], references: [id])
  ruleVersion ScoringRule @relation(fields: [ruleVersionId], references: [id])
  dataPoint   DataPoint   @relation(fields: [dataPointId], references: [id])

  @@unique([indicatorId, observationDate, ruleVersionId])
  @@index([indicatorId, observationDate(sort: Desc)])
  @@index([observationDate, indicatorId])
  @@index([ruleVersionId])
  @@map("scores")
}

model NiftyScorecard {
  id                    String   @id @default(uuid())
  observationDate       DateTime @map("observation_date") @db.Date
  vintageDate           DateTime @default(now()) @map("vintage_date")
  isCurrent             Boolean  @default(true) @map("is_current")
  toolVersion           Int      @default(2) @map("tool_version")
  ratingRuleId          String   @map("rating_rule_id")
  netScore              Int      @map("net_score") @db.SmallInt
  domesticScore         Int      @map("domestic_score") @db.SmallInt
  externalScore         Int      @map("external_score") @db.SmallInt
  positiveCount         Int      @map("positive_count") @db.SmallInt
  negativeCount         Int      @map("negative_count") @db.SmallInt
  neutralCount          Int      @map("neutral_count") @db.SmallInt
  ratingLabel           String   @map("rating_label") @db.VarChar(30)
  specialFlags          Json?    @map("special_flags")
  ind9RawComposite      Int?     @map("ind_9_raw_composite") @db.SmallInt
  // IND_NIFTY_13_FII_LS_RATIO's score for this date. Persisted standalone since
  // 2026-08-17 — Ind 13 is deliberately excluded from domestic/external/net
  // (see scorecard-assembly.service.ts). Still computed and returned by the API.
  ind13Score            Int?     @map("ind_13_score") @db.SmallInt
  compositionFlag       String?  @map("composition_flag") @db.VarChar(40)
  conflictFlag          Boolean  @default(false) @map("conflict_flag")
  peakScoreCeilingState Json?    @map("peak_score_ceiling_state")
  band                  String?  @db.VarChar(20)
  niftyClose            Decimal? @map("nifty_close") @db.Decimal(10, 2)
  scoreVelocity1d       Decimal? @map("score_velocity_1d") @db.Decimal(6, 2)
  scoreVelocity5d       Decimal? @map("score_velocity_5d") @db.Decimal(6, 2)
  indicatorBreakdown    Json     @map("indicator_breakdown")
  computedAt            DateTime @default(now()) @map("computed_at")
  isStale               Boolean  @default(false) @map("is_stale")
  // True when observationDate is not an NSE trading day (weekend or holiday,
  // per NseHoliday) — added 2026-08-17. Existing offenders were backfilled;
  // generation is gated against creating new ones (see scorecard-assembly
  // trigger paths). Never deleted, only marked — excluded from velocity,
  // anchor selection, band distribution, and historical series reads.
  isNonTradingDay       Boolean  @default(false) @map("is_non_trading_day")

  ratingRule ScorecardRatingRule @relation(fields: [ratingRuleId], references: [id])

  @@unique([observationDate, vintageDate], name: "nifty_scorecard_observation_vintage_unique")
  @@index([ratingLabel, observationDate(sort: Desc)])
  @@index([observationDate, isCurrent], map: "nifty_scorecards_observation_current_idx")
  // Hot path: latest current scorecard (getLatestScorecard / velocity / v-bottom).
  @@index([isCurrent, observationDate(sort: Desc)], map: "nifty_scorecards_current_date_idx")
  @@map("nifty_scorecards")
}

// NSE holiday reference — combined with a plain weekend (Sat/Sun) check to
// determine trading days. See src/core/utils/trading-calendar.ts. Populated
// 2026-08-17 for 2022-06-15 (earliest data_points row across all NIFTY
// indicators) through 2026-12-25; 2027 is a known, reported gap — NSE had not
// published its 2027 holiday circular as of this table's creation. Source:
// calendarlabs.com's NSE market holiday pages (a third-party aggregator, not
// NSE's own circular directly — direct fetches of nseindia.com and
// archives.nseindia.com both failed during this work; see chat report).
//
// NOTE: this table is intentionally NOT the sole enforcement mechanism for
// the partial unique index added on data_points in the same phase — it only
// backs the NIFTY scorecard trading-day gate and velocity's session count.
model NseHoliday {
  date      DateTime @id @db.Date
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("nse_holidays")
}

model EdgefinderScorecard {
  id              String   @id @default(uuid())
  assetId         String   @map("asset_id")
  observationDate DateTime @map("observation_date") @db.Date

  vintageDate DateTime @default(now()) @map("vintage_date")
  isCurrent   Boolean  @default(true) @map("is_current")

  baseFundamentalsScore Int    @map("base_fundamentals_score") @db.SmallInt
  fundamentalsScore     Int    @map("fundamentals_score") @db.SmallInt
  cotScore              Int    @map("cot_score") @db.SmallInt
  totalScore            Int    @map("total_score") @db.SmallInt
  ratingLabel           String @map("rating_label") @db.VarChar(30)

  compassAdjustment       Int     @default(0) @map("compass_adjustment") @db.SmallInt
  compassOverridesApplied Json?   @map("compass_overrides_applied")
  regimeAtCompute         String? @map("regime_at_compute") @db.VarChar(15)

  indicatorBreakdown Json  @map("indicator_breakdown")
  cotBreakdown       Json? @map("cot_breakdown")

  computedAt DateTime @default(now()) @map("computed_at")
  isStale    Boolean  @default(false) @map("is_stale")

  asset Asset @relation(fields: [assetId], references: [id])

  @@unique([assetId, observationDate, vintageDate])
  @@index([assetId, observationDate(sort: Desc)])
  @@index([observationDate, totalScore(sort: Desc)])
  @@index([observationDate, isCurrent], map: "edgefinder_scorecards_observation_current_idx")
  // Hot path: latest current scorecard for a given asset (oracle scorecard/assets).
  @@index([assetId, isCurrent, observationDate(sort: Desc)], map: "edgefinder_scorecards_asset_current_date_idx")
  @@map("edgefinder_scorecards")
}

model EdgefinderPairScore {
  id        String   @id @default(uuid())
  pairId    String   @map("pair_id")
  scoreDate DateTime @map("score_date") @db.Date

  vintageDate DateTime @default(now()) @map("vintage_date")
  isCurrent   Boolean  @default(true) @map("is_current")

  basePairScore     Int @map("base_pair_score") @db.SmallInt
  pairCotScore      Int @map("pair_cot_score") @db.SmallInt
  baseTotal         Int @map("base_total") @db.SmallInt
  compassAdjustment Int @default(0) @map("compass_adjustment") @db.SmallInt
  totalScore        Int @map("total_score") @db.SmallInt

  compassOverridesApplied Json?   @map("compass_overrides_applied")
  regimeAtCompute         String? @map("regime_at_compute") @db.VarChar(15)
  ratingLabel             String  @map("rating_label") @db.VarChar(30)

  rowBreakdown Json  @map("row_breakdown")
  cotBreakdown Json? @map("cot_breakdown")

  computedAt DateTime @default(now()) @map("computed_at")

  pair Asset @relation(fields: [pairId], references: [id])

  @@unique([pairId, scoreDate, vintageDate])
  @@index([pairId, scoreDate(sort: Desc)])
  @@index([scoreDate, isCurrent], map: "edgefinder_pair_scores_score_date_current_idx")
  // Hot path: latest current pair score for given pairs (oracle assets/fx-scorecard).
  @@index([pairId, isCurrent, scoreDate(sort: Desc)], map: "edgefinder_pair_scores_pair_current_date_idx")
  @@map("edgefinder_pair_scores")
}

